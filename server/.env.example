# Copy to .env and fill in your values

# ── Master server ─────────────────────────────────────────────────────────────
MASTER_PORT=3000

# ── Auth server ───────────────────────────────────────────────────────────────
AUTH_PORT=4000

# ── Game server ───────────────────────────────────────────────────────────────
SERVER_NAME=My 8a8 Server
SERVER_DESC=GTA VI multiplayer server
SERVER_ADDRESS=127.0.0.1       # <-- your public IP (127.0.0.1 for local testing)
SERVER_PORT=30120
RESOURCE_PORT=8080            # HTTP port for resource downloads
HEARTBEAT_INTERVAL_MS=15000   # how often the game server pings master (ms)
MAX_PLAYERS=32
SERVER_MODE=freeroam
SERVER_TAGS=english,freeroam
SERVER_REGION=us-east
SERVER_LANG=en
# SERVER_PASSWORD=secretpassword

MASTER_URL=http://localhost:3000/api
AUTH_URL=http://localhost:4000
