<UserControl x:Class="LeoM.Views.ServerBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" Background="{StaticResource Bg1Brush}"
            BorderBrush="{StaticResource Bg3Brush}" BorderThickness="0,0,0,1">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,5,8,5"
                 VerticalContentAlignment="Center"
                 Text="" TextChanged="FilterBox_TextChanged"
                 Tag="Search servers...">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Background">
                    <Setter.Value>
                      <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                        <VisualBrush.Visual>
                          <TextBlock Text="Search servers..." Foreground="#FF5A5A5A"
                                     FontStyle="Italic" Margin="6,0,0,0" FontSize="11"/>
                        </VisualBrush.Visual>
                      </VisualBrush>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <ComboBox x:Name="RegionFilter" Grid.Column="1" Width="90" Margin="0,5,6,5"
                  SelectionChanged="RegionFilter_SelectionChanged"/>
        <ComboBox x:Name="ModeFilter" Grid.Column="2" Width="90" Margin="0,5,6,5"
                  SelectionChanged="ModeFilter_SelectionChanged"/>
        <CheckBox x:Name="HideFullCheck" Grid.Column="3" VerticalAlignment="Center"
                  Content="Hide Full" Margin="0,0,8,0" Checked="ApplyFilter" Unchecked="ApplyFilter"/>
        <Button Grid.Column="4" Content="Refresh" Padding="10,5" Margin="0,5"
                Click="Refresh_Click"/>
      </Grid>
    </Border>

    <!-- Server list + detail panel -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="ServerGrid" Grid.Column="0"
                SelectionChanged="ServerGrid_SelectionChanged"
                MouseDoubleClick="ServerGrid_DoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Server Name"  Binding="{Binding Name}"          Width="*"   MinWidth="160"/>
          <DataGridTextColumn Header="Mode"         Binding="{Binding Mode}"           Width="90"/>
          <DataGridTextColumn Header="Players"      Binding="{Binding PlayerDisplay}"  Width="72"/>
          <DataGridTextColumn Header="Ping"         Binding="{Binding PingDisplay}"    Width="55"/>
          <DataGridTextColumn Header="Region"       Binding="{Binding Region}"         Width="68"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Right detail panel -->
      <Border Grid.Column="1" Background="{StaticResource Bg1Brush}"
              BorderBrush="{StaticResource Bg3Brush}" BorderThickness="1,0,0,0">
        <StackPanel x:Name="DetailPanel" Margin="12">
          <TextBlock x:Name="DetailName" Text="—" FontSize="13" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBlock x:Name="DetailAddr" Foreground="{StaticResource Tx1Brush}"
                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,2"/>
          <Separator Margin="0,8"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Players" Foreground="{StaticResource Tx2Brush}" FontSize="10"/>
            <TextBlock x:Name="DetailPlayers" Grid.Column="1" HorizontalAlignment="Right" FontSize="11"/>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Ping" Foreground="{StaticResource Tx2Brush}" FontSize="10"/>
            <TextBlock x:Name="DetailPing" Grid.Column="1" HorizontalAlignment="Right" FontSize="11"
                       FontFamily="Consolas"/>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Region" Foreground="{StaticResource Tx2Brush}" FontSize="10"/>
            <TextBlock x:Name="DetailRegion" Grid.Column="1" HorizontalAlignment="Right" FontSize="11"/>
          </Grid>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Version" Foreground="{StaticResource Tx2Brush}" FontSize="10"/>
            <TextBlock x:Name="DetailVersion" Grid.Column="1" HorizontalAlignment="Right"
                       FontFamily="Consolas" FontSize="11"/>
          </Grid>
          <Separator Margin="0,8"/>
          <TextBlock Text="Description" Foreground="{StaticResource Tx2Brush}" FontSize="10" Margin="0,0,0,4"/>
          <TextBlock x:Name="DetailDesc" TextWrapping="Wrap" FontSize="11"
                     Foreground="{StaticResource Tx1Brush}"/>
          <Separator Margin="0,8"/>
          <StackPanel x:Name="TagsPanel" Orientation="Horizontal" FlowDirection="LeftToRight"
                      Margin="0,0,0,8"/>
          <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource AccentButton}"
                  IsEnabled="False" Click="ConnectBtn_Click" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
            BorderBrush="{StaticResource Bg3Brush}" BorderThickness="0,1,0,0" Height="22">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource Tx1Brush}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="FetchIndicator" Width="6" Height="6" Margin="0,0,6,0"
                   Fill="{StaticResource Tx2Brush}"/>
          <TextBlock x:Name="FetchStatus" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
