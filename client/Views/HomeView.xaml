<UserControl x:Class="LeoM.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0Brush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">

      <TextBlock Text="LeoM" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource AccBrush}" Margin="0,0,0,2" FontFamily="Consolas"/>
      <TextBlock Text="8a8 Multiplayer Client" FontSize="12"
                 Foreground="{StaticResource Tx1Brush}" Margin="0,0,0,20"/>

      <!-- Account panel (login / register) -->
      <TextBlock Text="ACCOUNT" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,8"/>
      <Border x:Name="LoginPanel" Background="{StaticResource Bg1Brush}"
              BorderBrush="{StaticResource Bg3Brush}" BorderThickness="1"
              Padding="12" Margin="0,0,0,20">
        <StackPanel>
          <!-- Logged-in state -->
          <StackPanel x:Name="LoggedInState" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LoggedInName" Grid.Column="0"
                         FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource AccBrush}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Log out" FontSize="11"
                      Padding="8,2" Click="LogoutBtn_Click"/>
            </Grid>
          </StackPanel>

          <!-- Login / register form -->
          <StackPanel x:Name="LoginState">
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" FontSize="11"
                         Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
              <TextBox x:Name="UsernameBox" Grid.Row="0" Grid.Column="1"
                       FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" FontSize="11"
                         Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
              <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"
                           FontFamily="Consolas" FontSize="12"/>
            </Grid>
            <TextBlock x:Name="AuthError" Foreground="{StaticResource ErrBrush}"
                       FontSize="11" Margin="0,4,0,6" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Login" Style="{StaticResource AccentButton}"
                      Margin="0,0,8,0" Click="LoginBtn_Click"/>
              <Button Content="Create Account" Click="RegisterBtn_Click"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Status grid -->
      <TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,8"/>
      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="12" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Server"
                     Foreground="{StaticResource Tx2Brush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="MasterStatus" Grid.Row="0" Grid.Column="2"
                     FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Auth Server"
                     Foreground="{StaticResource Tx2Brush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="AuthStatus" Grid.Row="1" Grid.Column="2"
                     FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Game Installed"
                     Foreground="{StaticResource Tx2Brush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="GameStatus" Grid.Row="2" Grid.Column="2"
                     FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Servers Online"
                     Foreground="{StaticResource Tx2Brush}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="ServersCount" Grid.Row="3" Grid.Column="2"
                     FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Quick nav -->
      <StackPanel Orientation="Horizontal">
        <Button Content="Browse Servers" Style="{StaticResource AccentButton}"
                Margin="0,0,8,0" Click="BrowseBtn_Click"/>
        <Button Content="Create Server" Margin="0,0,8,0" Click="CreateServerBtn_Click"/>
        <Button Content="Settings" Click="SettingsBtn_Click"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
