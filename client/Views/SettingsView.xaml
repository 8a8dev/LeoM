<UserControl x:Class="LeoM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0Brush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="480" HorizontalAlignment="Left">

      <TextBlock Text="SETTINGS" FontSize="10" FontFamily="Consolas"
                 Foreground="{StaticResource Tx2Brush}" Margin="0,0,0,20"/>

      <!-- Game -->
      <TextBlock Text="GAME" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,8"/>
      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="14" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="GTA VI install path" Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,0,0,3"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GamePathBox" Grid.Column="0" FontFamily="Consolas" FontSize="11"/>
            <Button Grid.Column="2" Content="Browse..." Click="BrowseGamePath_Click" Padding="10,5"/>
          </Grid>
          <TextBlock Text="Additional launch arguments" Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,0,0,3"/>
          <TextBox x:Name="LaunchArgsBox" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>
      </Border>

      <!-- Network -->
      <TextBlock Text="NETWORK" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,8"/>
      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="14" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Master server URL" Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,0,0,3"/>
          <TextBox x:Name="MasterUrlBox" FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>
          <TextBlock Text="Auth server URL" Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,0,0,3"/>
          <TextBox x:Name="AuthUrlBox" FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Max ping filter (ms)" Foreground="{StaticResource Tx2Brush}"
                       FontSize="10" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxPingBox" Grid.Column="1" FontFamily="Consolas" FontSize="11" TextAlignment="Right"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Auto-refresh interval (s)" Foreground="{StaticResource Tx2Brush}"
                       FontSize="10" VerticalAlignment="Center"/>
            <TextBox x:Name="RefreshBox" Grid.Column="1" FontFamily="Consolas" FontSize="11" TextAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Identity -->
      <TextBlock Text="IDENTITY" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,8"/>
      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="14" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Nickname" Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,0,0,3"/>
          <TextBox x:Name="NicknameBox"/>
          <TextBlock Text="Shown to other players on the server." Foreground="{StaticResource Tx2Brush}"
                     FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- Save -->
      <StackPanel Orientation="Horizontal">
        <Button Content="Save Settings" Style="{StaticResource AccentButton}"
                Margin="0,0,8,0" Click="Save_Click"/>
        <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="11"
                   Foreground="{StaticResource OkBrush}" Visibility="Collapsed"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
