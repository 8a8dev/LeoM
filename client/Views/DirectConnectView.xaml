<UserControl x:Class="LeoM.Views.DirectConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0Brush}">
  <StackPanel Margin="24" MaxWidth="420" HorizontalAlignment="Left">

    <TextBlock Text="DIRECT CONNECT" FontSize="10" FontFamily="Consolas"
               Foreground="{StaticResource Tx2Brush}" Margin="0,0,0,16"/>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="80"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="IP Address" Foreground="{StaticResource Tx2Brush}" FontSize="10" Margin="0,0,0,3"/>
        <TextBox x:Name="IpBox" FontFamily="Consolas"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Port" Foreground="{StaticResource Tx2Brush}" FontSize="10" Margin="0,0,0,3"/>
        <TextBox x:Name="PortBox" FontFamily="Consolas" Text="30120"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="Password (optional)" Foreground="{StaticResource Tx2Brush}"
               FontSize="10" Margin="0,0,0,3"/>
    <PasswordBox x:Name="PassBox" Background="{StaticResource Bg2Brush}"
                 Foreground="{StaticResource Tx0Brush}"
                 BorderBrush="{StaticResource Bg3Brush}" BorderThickness="1"
                 Padding="6,4" Margin="0,0,0,16" FontFamily="Consolas"/>

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrBrush}"
               FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal">
      <Button Content="Connect" Style="{StaticResource AccentButton}"
              Margin="0,0,8,0" Click="ConnectBtn_Click"/>
      <Button x:Name="PingBtn" Content="Ping" Click="PingBtn_Click"/>
      <TextBlock x:Name="PingResult" Margin="12,0,0,0" VerticalAlignment="Center"
                 FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Tx1Brush}"/>
    </StackPanel>

  </StackPanel>
</UserControl>
