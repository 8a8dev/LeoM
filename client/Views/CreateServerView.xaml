<UserControl x:Class="LeoM.Views.CreateServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0Brush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">

      <TextBlock Text="CREATE SERVER" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,0,0,16"/>

      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="16" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Name" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvName" Grid.Row="0" Grid.Column="1"
                   FontFamily="Consolas" Text="My 8a8 Server" Margin="0,2"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvDesc" Grid.Row="1" Grid.Column="1"
                   FontFamily="Consolas" Margin="0,2"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Public IP" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvAddress" Grid.Row="2" Grid.Column="1"
                   FontFamily="Consolas" Margin="0,2"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="UDP Port" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvPort" Grid.Row="3" Grid.Column="1"
                   FontFamily="Consolas" Text="30120" Margin="0,2"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Players" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvMaxPlayers" Grid.Row="4" Grid.Column="1"
                   FontFamily="Consolas" Text="32" Margin="0,2"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Mode" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvMode" Grid.Row="5" Grid.Column="1"
                   FontFamily="Consolas" Text="freeroam" Margin="0,2"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Tags" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <TextBox x:Name="SrvTags" Grid.Row="6" Grid.Column="1"
                   FontFamily="Consolas" Text="english,freeroam" Margin="0,2"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Password" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
          <PasswordBox x:Name="SrvPassword" Grid.Row="7" Grid.Column="1"
                       FontFamily="Consolas" Margin="0,2"/>
        </Grid>
      </Border>

      <TextBlock x:Name="SrvError" Foreground="{StaticResource ErrBrush}"
                 FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>
      <TextBlock x:Name="SrvStatus" Foreground="{StaticResource Tx1Brush}"
                 FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>

      <StackPanel Orientation="Horizontal">
        <Button x:Name="LaunchBtn" Content="Launch Server" Style="{StaticResource AccentButton}"
                Margin="0,0,8,0" Click="LaunchBtn_Click"/>
        <Button x:Name="StopBtn" Content="Stop Server" IsEnabled="False"
                Click="StopBtn_Click"/>
      </StackPanel>

      <!-- Console output -->
      <TextBlock Text="CONSOLE" FontSize="10" Foreground="{StaticResource Tx2Brush}"
                 FontFamily="Consolas" Margin="0,20,0,8"/>
      <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource Bg3Brush}"
              BorderThickness="1" Padding="8" Height="200">
        <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ConsoleOut" FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource Tx1Brush}" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
