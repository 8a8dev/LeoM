<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LeoM</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- 8a8.dev fingerprint — baked into the compiled assembly. -->
    <Product>LeoM</Product>
    <Company>8a8.dev</Company>
    <Authors>8a8.dev</Authors>
    <Copyright>Copyright (c) 8a8.dev — https://8a8.dev</Copyright>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0+8a8.dev</InformationalVersion>
    <RepositoryUrl>https://github.com/8a8dev/LeoM</RepositoryUrl>

    <!-- keep build output free of local machine paths -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
