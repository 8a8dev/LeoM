<Window x:Class="LeoM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeoM.Views"
        Title="LeoM · 8a8.dev" Width="1100" Height="680" MinWidth="800" MinHeight="500"
        WindowStyle="None" Background="{StaticResource Bg0Brush}"
        BorderBrush="{StaticResource Bg3Brush}" BorderThickness="1">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="4"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
            BorderBrush="{StaticResource Bg3Brush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="LeoM" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                     Foreground="{StaticResource AccBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="GTA VI Multiplayer Client" FontSize="11"
                     Foreground="{StaticResource Tx2Brush}" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- Window controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinBtn" Content="—" Width="46" Background="Transparent"
                  BorderThickness="0" Foreground="{StaticResource Tx1Brush}"
                  FontSize="12" Click="MinBtn_Click"
                  Style="{x:Null}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="Transparent" Width="46" Height="32">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HovBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="MaxBtn" Content="□" Width="46" Foreground="{StaticResource Tx1Brush}"
                  FontSize="12" Click="MaxBtn_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="Transparent" Width="46" Height="32">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HovBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="CloseBtn" Content="✕" Width="46" Foreground="{StaticResource Tx1Brush}"
                  FontSize="11" Click="CloseBtn_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="Transparent" Width="46" Height="32">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ErrBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body: sidebar + content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
              BorderBrush="{StaticResource Bg3Brush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ListBox x:Name="NavList" Grid.Row="0" SelectionChanged="NavList_SelectionChanged"
                   Margin="0,8,0,0">
            <ListBoxItem Tag="home"         Content="Home"/>
            <ListBoxItem Tag="servers"      Content="Servers"/>
            <ListBoxItem Tag="direct"       Content="Direct Connect"/>
            <ListBoxItem Tag="createserver" Content="Create Server"/>
            <ListBoxItem Tag="history"      Content="History"/>
          </ListBox>

          <ListBox x:Name="NavBottom" Grid.Row="1" SelectionChanged="NavBottom_SelectionChanged"
                   Margin="0,0,0,8">
            <ListBoxItem Tag="settings" Content="Settings"/>
          </ListBox>
        </Grid>
      </Border>

      <!-- Content area -->
      <Grid Grid.Column="1" x:Name="ContentGrid">
        <local:HomeView          x:Name="HomeView"       Visibility="Visible"/>
        <local:ServerBrowserView x:Name="ServersView"   Visibility="Collapsed"/>
        <local:DirectConnectView x:Name="DirectView"    Visibility="Collapsed"/>
        <local:SettingsView      x:Name="SettingsView"  Visibility="Collapsed"/>
        <local:HistoryView       x:Name="HistoryView"   Visibility="Collapsed"/>
        <local:CreateServerView  x:Name="CreateSrvView" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
