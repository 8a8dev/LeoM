<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Colors ──────────────────────────────────────────────────────────────── -->
  <Color x:Key="Bg0">#FF1E1E1E</Color>
  <Color x:Key="Bg1">#FF252526</Color>
  <Color x:Key="Bg2">#FF2D2D30</Color>
  <Color x:Key="Bg3">#FF3C3C3C</Color>
  <Color x:Key="Tx0">#FFD4D4D4</Color>
  <Color x:Key="Tx1">#FF9D9D9D</Color>
  <Color x:Key="Tx2">#FF6D6D6D</Color>
  <Color x:Key="Acc">#FF0098FF</Color>
  <Color x:Key="AccDim">#33007ACC</Color>
  <Color x:Key="Sel">#FF094771</Color>
  <Color x:Key="Hov">#FF2A2D2E</Color>
  <Color x:Key="Err">#FFF44747</Color>
  <Color x:Key="Ok">#FF4EC94E</Color>
  <Color x:Key="Warn">#FFFFC83D</Color>

  <SolidColorBrush x:Key="Bg0Brush"   Color="{StaticResource Bg0}"/>
  <SolidColorBrush x:Key="Bg1Brush"   Color="{StaticResource Bg1}"/>
  <SolidColorBrush x:Key="Bg2Brush"   Color="{StaticResource Bg2}"/>
  <SolidColorBrush x:Key="Bg3Brush"   Color="{StaticResource Bg3}"/>
  <SolidColorBrush x:Key="Tx0Brush"   Color="{StaticResource Tx0}"/>
  <SolidColorBrush x:Key="Tx1Brush"   Color="{StaticResource Tx1}"/>
  <SolidColorBrush x:Key="Tx2Brush"   Color="{StaticResource Tx2}"/>
  <SolidColorBrush x:Key="AccBrush"   Color="{StaticResource Acc}"/>
  <SolidColorBrush x:Key="AccDimBrush" Color="{StaticResource AccDim}"/>
  <SolidColorBrush x:Key="SelBrush"   Color="{StaticResource Sel}"/>
  <SolidColorBrush x:Key="HovBrush"   Color="{StaticResource Hov}"/>
  <SolidColorBrush x:Key="ErrBrush"   Color="{StaticResource Err}"/>
  <SolidColorBrush x:Key="OkBrush"    Color="{StaticResource Ok}"/>
  <SolidColorBrush x:Key="WarnBrush"  Color="{StaticResource Warn}"/>
  <SolidColorBrush x:Key="Transparent" Color="Transparent"/>

  <!-- ── Typography ──────────────────────────────────────────────────────────── -->
  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSm">11</System:Double>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontMd">12</System:Double>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontLg">13</System:Double>

  <!-- ── Window ──────────────────────────────────────────────────────────────── -->
  <Style TargetType="Window">
    <Setter Property="Background"  Value="{StaticResource Bg0Brush}"/>
    <Setter Property="Foreground"  Value="{StaticResource Tx0Brush}"/>
    <Setter Property="FontFamily"  Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"    Value="{StaticResource FontMd}"/>
  </Style>

  <!-- ── TextBlock ───────────────────────────────────────────────────────────── -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Tx0Brush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"   Value="{StaticResource FontMd}"/>
  </Style>

  <!-- ── TextBox ─────────────────────────────────────────────────────────────── -->
  <Style TargetType="TextBox">
    <Setter Property="Background"        Value="{StaticResource Bg2Brush}"/>
    <Setter Property="Foreground"        Value="{StaticResource Tx0Brush}"/>
    <Setter Property="BorderBrush"       Value="{StaticResource Bg3Brush}"/>
    <Setter Property="BorderThickness"   Value="1"/>
    <Setter Property="Padding"           Value="6,4"/>
    <Setter Property="FontFamily"        Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"          Value="{StaticResource FontMd}"/>
    <Setter Property="CaretBrush"        Value="{StaticResource Tx0Brush}"/>
    <Setter Property="SelectionBrush"    Value="{StaticResource AccDimBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ── Button ──────────────────────────────────────────────────────────────── -->
  <Style TargetType="Button">
    <Setter Property="Background"      Value="{StaticResource Bg2Brush}"/>
    <Setter Property="Foreground"      Value="{StaticResource Tx0Brush}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource Bg3Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="14,5"/>
    <Setter Property="FontFamily"      Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"        Value="{StaticResource FontMd}"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3Brush}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource SelBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Accent button -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background"  Value="{StaticResource AccBrush}"/>
    <Setter Property="Foreground"  Value="#FFFFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccBrush}"/>
    <Setter Property="FontWeight"  Value="SemiBold"/>
  </Style>

  <!-- ── CheckBox ────────────────────────────────────────────────────────────── -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground"  Value="{StaticResource Tx0Brush}"/>
    <Setter Property="FontFamily"  Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"    Value="{StaticResource FontMd}"/>
    <Setter Property="Margin"      Value="0,2"/>
  </Style>

  <!-- ── ComboBox ────────────────────────────────────────────────────────────── -->
  <Style TargetType="ComboBox">
    <Setter Property="Background"      Value="{StaticResource Bg2Brush}"/>
    <Setter Property="Foreground"      Value="{StaticResource Tx0Brush}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource Bg3Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="6,4"/>
    <Setter Property="FontFamily"      Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"        Value="{StaticResource FontMd}"/>
  </Style>

  <!-- ── Separator ───────────────────────────────────────────────────────────── -->
  <Style TargetType="Separator">
    <Setter Property="Background"  Value="{StaticResource Bg3Brush}"/>
    <Setter Property="Height"      Value="1"/>
    <Setter Property="Margin"      Value="0"/>
  </Style>

  <!-- ── ScrollBar ───────────────────────────────────────────────────────────── -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
    <Setter Property="Width"      Value="8"/>
  </Style>

  <!-- ── DataGrid ────────────────────────────────────────────────────────────── -->
  <Style TargetType="DataGrid">
    <Setter Property="Background"              Value="{StaticResource Bg1Brush}"/>
    <Setter Property="Foreground"              Value="{StaticResource Tx0Brush}"/>
    <Setter Property="BorderBrush"             Value="{StaticResource Bg3Brush}"/>
    <Setter Property="BorderThickness"         Value="0"/>
    <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Bg2Brush}"/>
    <Setter Property="RowBackground"           Value="{StaticResource Bg1Brush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg0Brush}"/>
    <Setter Property="SelectionMode"           Value="Single"/>
    <Setter Property="SelectionUnit"           Value="FullRow"/>
    <Setter Property="AutoGenerateColumns"     Value="False"/>
    <Setter Property="CanUserAddRows"          Value="False"/>
    <Setter Property="CanUserDeleteRows"       Value="False"/>
    <Setter Property="CanUserResizeRows"       Value="False"/>
    <Setter Property="IsReadOnly"              Value="True"/>
    <Setter Property="FontFamily"              Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"                Value="{StaticResource FontSm}"/>
    <Setter Property="RowHeight"               Value="26"/>
    <Setter Property="ColumnHeaderHeight"      Value="24"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll"    Value="True"/>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Tx0Brush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource HovBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderThickness="0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Tx0Brush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background"      Value="{StaticResource Bg2Brush}"/>
    <Setter Property="Foreground"      Value="{StaticResource Tx1Brush}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource Bg3Brush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding"         Value="6,0"/>
    <Setter Property="FontWeight"      Value="Normal"/>
    <Setter Property="FontSize"        Value="{StaticResource FontSm}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── ListBox ─────────────────────────────────────────────────────────────── -->
  <Style TargetType="ListBox">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{StaticResource Tx0Brush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily"      Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"        Value="{StaticResource FontMd}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{StaticResource Tx1Brush}"/>
    <Setter Property="Padding"     Value="14,8"/>
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AccDimBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Tx0Brush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource HovBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Tx0Brush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── ProgressBar ─────────────────────────────────────────────────────────── -->
  <Style TargetType="ProgressBar">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource AccBrush}"/>
    <Setter Property="Height"     Value="4"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ── Label ───────────────────────────────────────────────────────────────── -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource Tx1Brush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize"   Value="{StaticResource FontMd}"/>
    <Setter Property="Padding"    Value="0"/>
  </Style>

</ResourceDictionary>
